---
import Layout from "@/layouts/Layout.astro";
import Bento from "@/components/home/Bento.astro";
import Card from "@/components/Card/index.astro";

import Introduction from "@/components/home/Introduction.astro";
import ProfileCard from "@/components/home/ProfileCard.astro";
import AreaCard from "@/components/home/AreaCard.astro";
import BackgroundRing from "@/components/Animations/BackgroundRing.astro";
import Link from "@/components/Link.astro";
import ProyectGallery from "@/components/home/ProyectGallery.astro";
import { Computer, Github, Linkedin, MailIcon, Gamepad } from "lucide-react";
import gamedevCVPath from "@/assets/files/CV/Gamedev/es/Daniel Alonso Herranz - CV.pdf";
import softwareCVPath from "@/assets/files/CV/Software/es/Daniel Alonso Herranz - CV.pdf";
import placeholder from "@/assets/images/placeholders/placeholder1.jpg";
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

