---
import Link from "@/components/Link.astro";
import Layout from "@/layouts/Layout.astro";
import { ArrowBigLeftDash } from "lucide-react";
import Card from "@/components/Card/index.astro";
import { getCollection } from "astro:content";
import ProyectCard from "@/components/home/ProyectCard.astro";
import GalleryCard from "@/components/gallery/GalleryCard.astro";
import ReturnCard from "@/components/gallery/ReturnCard.astro";


const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/placeholders/*.{jpeg,jpg,png,gif}",
  { eager: true },
);

const currentLang = Astro.currentLocale ?? "es";

// 1. Fetch Obsidian projects
const projects = await getCollection("projects", ({data}) => {
  return (data.lang ?? "en") === currentLang;
});

// 2. Load vault images
const vaultImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/vault/**/*.{jpeg,jpg,png,gif,webp,avif,svg}",
  { eager: true },
);


const imageMap = new Map<string, ImageMetadata>();
for (const [path, mod] of Object.entries(vaultImages)) {
  const filename = path.split("/").pop();
  if (filename) imageMap.set(filename, mod.default);
}


// 3. Grid span presets for variation
const gridPresets = [
  { colSpan: "col-span-1", rowSpan: "row-span-1" },
  { colSpan: "col-span-2", rowSpan: "row-span-2" },
  { colSpan: "col-span-3", rowSpan: "row-span-3" },
];

const imageList = Object.values(images).map((m) => m.default);

const markdownLinkRegex = /\[([^\]]+)\]\(([^)]+)\)/g;
const extractLinks = (content: string) =>
  [...content.matchAll(markdownLinkRegex)].map(([, name, link]) => [name, link] as [string, string]);


---

<Layout>
  
    
  
  
  <div class="w-full h-full p-20 transition:fade">
    <div class="w-full h-full grid grid-cols-6 grid-rows-6 gap-2 z-10">
      
      
       <ReturnCard/>

       {
              projects.map((project, index) => {
                const projectImages = (project.data.images || [])
                  .map((img: any) => imageMap.get(img.title ?? img.href?.split("/").pop()))
                  .filter((img): img is ImageMetadata => Boolean(img));
    
                const carouselImages = projectImages.length > 0 ? projectImages : imageList;
                var cleanText = project.body ? project.body.replace(/!\[\[.*?\]\]/g, "").trim() : "";
                const links = extractLinks(cleanText);
                cleanText = cleanText.replace(markdownLinkRegex, "").trim()
                const preset = gridPresets[index % gridPresets.length];


    
                return (
    		 <GalleryCard
                    colSpan={preset.colSpan}
                    rowSpan={preset.rowSpan}
                    carouselImages={carouselImages}
                    links={links}>
                    <!-- Thumbnail on the grid -->
                    <img
                      slot="thumbnail"
                      src={carouselImages[0].src}
                      alt={project.data.title || "Project image"}
                      class="w-full h-full object-cover"
                    />

                    <!-- Title in modal overlay -->
                    <span slot="title">{project.data.title || "Untitled Project"}</span>

                    <!-- Text in modal overlay -->
                    <p slot="description">{cleanText}</p>

                    <p slot="link"></p>
    		 </GalleryCard>
                );
              })
            }        
      </div>
    </div>
</Layout>

<style>
  #gallery-container {
    margin-left: 10%;
    margin-right: 10%;

    min-width: 90%;
    min-height: 90%;

    display: grid;
    grid-template-columns: 10% 80% 10%;
    grid-template-rows: 10% 90%;
  }
</style>
