---
import type { HTMLAttributes } from "astro/types"

import { cn } from "@/lib/utils"

import NavigationMenuViewport from "./navigation-menu-viewport.astro"

interface Props extends HTMLAttributes<"nav"> {
  viewport?: boolean
  delayOpen?: number
  delayClose?: number
  openOnFocus?: boolean
}

const {
  class: className = "",
  viewport = true,
  delayOpen = 0,
  delayClose = 50,
  openOnFocus,
  ...props
} = Astro.props
---

<nav
  {...props}
  data-slot="navigation-menu"
  data-viewport={viewport}
  data-delay-open={delayOpen}
  data-delay-close={delayClose}
  data-open-on-focus={openOnFocus}
  class={cn(
    "group/navigation-menu relative flex max-w-max flex-1 items-center justify-center",
    className
  )}
>
  <slot />
  {viewport && <NavigationMenuViewport />}
</nav>

<script>
  import { createNavigationMenu } from "@data-slot/navigation-menu"

  const registryKey = "__navigationMenuControllers__"
  const listenersBoundKey = "__navigationMenuSwapListenersBound__"

  const getRegistry = () => {
    const globalScope = window as Window & {
      [registryKey]?: WeakMap<Element, ReturnType<typeof createNavigationMenu>>
    }

    if (!globalScope[registryKey]) {
      globalScope[registryKey] = new WeakMap()
    }

    return globalScope[registryKey]
  }

  const bindNavigationMenus = (forceReset = false) => {
    const registry = getRegistry()

    document.querySelectorAll('[data-slot="navigation-menu"]').forEach((el) => {
      const existingController = registry.get(el)

      if (forceReset && existingController) {
        existingController.destroy()
        registry.delete(el)
      }

      if (!registry.has(el)) {
        registry.set(el, createNavigationMenu(el))
      }
    })
  }

  bindNavigationMenus()

  const globalScope = window as Window & {
    [listenersBoundKey]?: boolean
  }

  if (!globalScope[listenersBoundKey]) {
    document.addEventListener("astro:after-swap", () => {
      bindNavigationMenus(true)
    })

    globalScope[listenersBoundKey] = true
  }
</script>
