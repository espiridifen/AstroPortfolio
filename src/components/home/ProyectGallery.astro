---
import Card from "@/components/Card/index.astro";
import type { ImageMetadata } from "astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/placeholders/*.{jpeg,jpg,png,gif}",
  { eager: true }
);

const imageList = Object.values(images).map((m) => m.default);

type Props = {};


const currentLang = Astro.currentLocale ?? "en";

const title = currentLang == "en" ? "Proyect Gallery" : "Galería de proyectos"

const {} = Astro.props;
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-5"
  title={title}
  href="gallery"
>
 
<div id="img-container" class="">
  <div class="photobanner flex flex-row">

    {
      imageList.map((img) => (
        <img src={img.src} alt="Project image" class="imageSlot" />
      ))
    }
    {
      imageList.map((img) => (
        <img src={img.src} alt="Project image" class="imageSlot" />
      ))
    }
  </div>
</div>
</Card>

<style>

@keyframes bannermove {
  0% {
      transform: translate(0, 0);
  }
  100% {
      transform: translate(-50%, 0);
  }
}

#img-container {
  height:10rem; 
  position:relative; 
  overflow:hidden;
  margin-top: 1.5rem;
}

.photobanner {
  position:absolute; 
  top:0px; 
  left:0px; 
  overflow:hidden; 
  white-space: nowrap;
  animation: bannermove 20s linear infinite;
}

.photobanner img {    
  margin: 0 0.5em 
}

.imageSlot {
  max-width: 10rem;
  max-height: 10rem;
  margin: 1rem;
}

</style>
