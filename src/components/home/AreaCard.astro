---
import DoubleBorder from './DoubleBorder.astro';
import Card from '@/components/Card/index.astro';

interface Props {
    title: string;
    items: string[];
    colSpan?: string;
    rowSpan?: string;
}   

const { title, items, colSpan, rowSpan } = Astro.props;
---

<Card colSpan={colSpan} rowSpan={rowSpan} title={title}>

    <div class="area-card">
        <ul class="items-list">
            {items.map((item) => (
                <li>{item}</li>
            ))}
    </ul>
</div>
</Card>


<style>
    .area-card {
        padding: 1.5rem;
        border-radius: 0.5rem;
        height: 100%;
    }

    h2 {
        margin: 0 0 1rem 0;
        font-size: 1.5rem;
        color: #1f2937;
    }

    .items-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .items-list li {
        padding: 0.5rem 0;
        color: #4b5563;
    }
</style>