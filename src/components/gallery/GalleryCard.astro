---
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogTitle,
  DialogTrigger,
} from "../starwind/dialog";

import {
  Carousel,
  CarouselContent,
  CarouselItem,
  CarouselNext,
  CarouselPrevious,
} from "../starwind/carousel";

import hbl from "@/assets/images/placeholders/placeholder1.jpg";
import ImageCarrousel from "./ImageCarrousel.astro";
import Button from "../starwind/button";

interface Props {
  colSpan: string;
  rowSpan: string;
  carouselImages: Array<ImageMetadata>;
  imageAspectClass?: string;
}

const {
  colSpan,
  rowSpan,
  carouselImages = [],
  imageAspectClass = "aspect-[4/3]",
} = Astro.props;

const rootClass = `${colSpan || "col-span-1"} ${rowSpan || "row-span-1"}`;
const thumbnailClass =
  "border-4 rounded-2xl overflow-hidden channel hover:border-fuchsia-800";

// Centralized style tokens to make visual tuning easier.
const modalClass =
  "bg-amber-500 w-[80vw] h-[80vh] max-w-[80vw] max-h-[80vh] overflow-y-auto";

const contentLayoutClass =
  "flex flex-col gap-6 md:flex-row md:items-start modalgrid";
---

<div class={rootClass}>
  <Dialog>
    <DialogTrigger>
      <div class={thumbnailClass}>
        <slot name="thumbnail">
          <img src={hbl.src} alt="ill be ur honey b lovely" />
        </slot>
      </div>
    </DialogTrigger>

    <DialogContent
      class="bg-mist-400 w-[70vw] h-[70vh] max-w-[80vw] max-h-[80vh] border-8 p-0 rounded-2xl overflow-y-clip min-h-0"
    >
      <DialogDescription>
        <!-- Description: flex-1 + h-full fills the left side; overflow-y-auto enables scrolling if text is long -->
        <div class="w-full h-full flex-1 min-h-0 max-h-4/5 border-2">
          <div class=" shrink-0 justify-center absolute top-0 left-0">
            <ImageCarrousel
              carouselImages={carouselImages}
              imageAspectClass={imageAspectClass}
            />
          </div>

          <div class="w-2/5 h-2/5 p-4 m-2 bg-blend-multiply flex flex-col opacity-80 bg-gray-800 rounded-xl text-cyan-200">
            <div class="text-2xl font-bold underline opacity-100">
              <slot name="title"> Title </slot>
            </div>
            <div class="h-full overflow-y-scroll z-10 opacity-100">
              <slot name="description">
                Default description with info about the project... Default
                description with info about the project...Default description
                with info about the project...Default description with info
                about the project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the
                project...Default description with info about the project...
              </slot>
            </div>
          </div>
        </div>

        <!-- Carousel: stays on the right side -->
        <!-- 
          -->
        <div
          class="absolute bottom-0 inset-x-0 z-20 bg-mist-600 w-full h-max min-h-0 border-2 flex flex-row justify-around p-10"
        >
          <Button class=" px-20 rounded-3xl bg-mist-500 border-3 border-sky-400">
            enrique
          </Button>

          <Button class=" px-20 rounded-3xl bg-mist-500 border-3 border-sky-400"> enrique </Button>

          <Button class=" px-20 rounded-3xl bg-mist-500 border-3 border-sky-400"> enrique </Button>
        </div>
      </DialogDescription>
    </DialogContent>
  </Dialog>
</div>

<style>
  .channel {
    position: relative;
    overflow: hidden;
    border-radius: 1rem; /* keep existing rounding if needed */
  }

  .channel::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      rgba(34, 34, 34, 0.25) 1rem,
      rgba(60, 60, 60, 0.18) 1.5rem,
      rgba(34, 34, 34, 0.25) 2rem
    );
    background-size: 100% 100%;
    animation: barberpole 20s linear infinite;
    mix-blend-mode: overlay; /* try 'overlay', 'multiply', or 'screen' */
    opacity: 0.8;
    pointer-events: none;
    z-index: 2;
  }

  .channel img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: relative;
    z-index: 1;
  }

  @keyframes barberpole {
    100% {
      background-position: 100% 100%;
    }
  }
</style>
