---
import {
  Dialog,
  DialogContent,
  DialogTrigger,
} from "../starwind/dialog";


import hbl from "@/assets/images/placeholders/placeholder1.jpg";
import ImageCarrousel from "./ImageCarrousel.astro";
import Button from "../starwind/button";

interface Props {
  colSpan: string;
  rowSpan: string;
  carouselImages: Array<ImageMetadata>;
  links: Array<[string, string]>
}

const {
  colSpan,
  rowSpan,
  carouselImages = [],
  links = []

} = Astro.props;

const rootClass = `${colSpan || "col-span-1"} ${rowSpan || "row-span-1"} w-full h-full`;

// Centralized style tokens to make visual tuning easier.
const modalClass =
  "bg-amber-500 w-[80vw] h-[80vh] max-w-[80vw] max-h-[80vh] overflow-y-auto";

const contentLayoutClass =
  "flex flex-col gap-6 md:flex-row md:items-start modalgrid";
---

<div class={rootClass}>
      <Dialog class="w-full h-full">
        <DialogTrigger class="w-full h-full">
          <div class="border-4 rounded-2xl overflow-hidden channel hover:border-fuchsia-800 w-full h-full min-h-0">
            <slot name="thumbnail">
              <img src={hbl.src} alt="thumbnail" class="h-full w-full object-cover"/>
            </slot>
          </div>
        </DialogTrigger>
    
        <DialogContent
          class="relative bg-mist-400 w-[70vw] h-[70vh] max-w-[80vw] max-h-[80vh] border-8 p-0 rounded-2xl overflow-hidden min-h-0"
        >
          <!-- 1. Full-bleed Carousel Layer (Background) -->
          <div class="absolute inset-0 w-full h-full z-0 overflow-hidden">
            <ImageCarrousel
              carouselImages={carouselImages}
              imageAspectClass="h-full w-full"
            />
          </div>
    
          <!-- 2. Overlay Content Layer (Top-Left Text) -->
          <div class="relative z-10 p-4 pointer-events-none">
            <div class="w-2/5 max-h-[40vh] p-4 bg-gray-900/80 backdrop-blur-md rounded-xl text-cyan-200 pointer-events-auto flex flex-col">
              <div class="text-2xl font-bold underline mb-2">
                <slot name="title">Title</slot>
              </div>
              <div class="overflow-y-auto max-h-[30vh]">
                <slot name="description">
                  Default description with info about the project...
                </slot>
              </div>
            </div>
          </div>
    
          <!-- 3. Bottom Action Bar (Pinned Bottom) -->
          <div
            class="absolute bottom-0 inset-x-0 z-20 bg-mist-600/90 backdrop-blur-sm w-full flex flex-row justify-around p-4 border-t-2"
          >
            {links.length > 0 ? (
              links.map(([label, href]) => (
                <Button href={href} class="px-8 rounded-3xl bg-mist-500 border-2 border-sky-400">
                  {label}
                </Button>
              ))
            ) : (
              <>
                <Button class="px-8 rounded-3xl bg-mist-500 border-2 border-sky-400">
                  Action 1
                </Button>
                <Button class="px-8 rounded-3xl bg-mist-500 border-2 border-sky-400">
                  Action 2
                </Button>
                <Button class="px-8 rounded-3xl bg-mist-500 border-2 border-sky-400">
                  Action 3
                </Button>
              </>
            )}

          </div>
        </DialogContent>
      </Dialog>
    </div>

<style>
  .channel {
    position: relative;
    overflow: hidden;
    border-radius: 1rem; /* keep existing rounding if needed */
    width: 100%;
    height: 100%;
  }

  .channel::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      rgba(34, 34, 34, 0.25) 1rem,
      rgba(60, 60, 60, 0.18) 1.5rem,
      rgba(34, 34, 34, 0.25) 2rem
    );
    background-size: 100% 100%;
    animation: barberpole 20s linear infinite;
    mix-blend-mode: overlay; /* try 'overlay', 'multiply', or 'screen' */
    opacity: 0.8;
    pointer-events: none;
    z-index: 2;
  }

  .channel img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: relative;
    z-index: 1;
  }

  @keyframes barberpole {
    100% {
      background-position: 100% 100%;
    }
  }
</style>
